//@version=6
indicator("相場の節目自動表示 Ver7（サイン付き）", overlay=true, max_lines_count=100, max_labels_count=100, max_boxes_count=50, max_bars_back=500)

//══════════════════════════════════════════════════════════════
// 設定
//══════════════════════════════════════════════════════════════
group_pd = "【前日】"
show_pdh = input.bool(true,  "前日高値", group=group_pd)
show_pdl = input.bool(true,  "前日安値", group=group_pd)
show_pdc = input.bool(true,  "前日終値", group=group_pd)
show_pdo = input.bool(false, "前日始値", group=group_pd)

group_w = "【週】"
show_pwh = input.bool(true,  "前週高値", group=group_w)
show_pwl = input.bool(true,  "前週安値", group=group_w)
show_cwo = input.bool(true,  "今週始値", group=group_w)

group_piv = "【ピボット】"
show_pivot = input.bool(true, "ピボット表示", group=group_piv)
show_r2 = input.bool(true, "R2", group=group_piv)
show_r1 = input.bool(true, "R1", group=group_piv)
show_pp = input.bool(true, "PP", group=group_piv)
show_s1 = input.bool(true, "S1", group=group_piv)
show_s2 = input.bool(false,"S2", group=group_piv)

group_ses = "【セッションボックス】"
show_tokyo_box  = input.bool(true, "東京時間ボックス", group=group_ses)
show_london_box = input.bool(true, "ロンドン時間ボックス", group=group_ses)
show_ny_box     = input.bool(true, "NY時間ボックス", group=group_ses)

tokyo_sess  = input.session("0900-1800", "東京時間", group=group_ses)
london_sess = input.session("1600-0100", "ロンドン時間", group=group_ses)
ny_sess     = input.session("2100-0600", "NY時間", group=group_ses)

tokyo_bg  = input.color(color.new(#1a237e, 75), "東京背景色", group=group_ses)
london_bg = input.color(color.new(#e65100, 75), "ロンドン背景色", group=group_ses)
ny_bg     = input.color(color.new(#004d40, 75), "NY背景色", group=group_ses)

group_round = "【キリ番（心理的節目）】"
show_round = input.bool(true, "キリ番を表示", group=group_round)
round_step = input.float(50.0, "キリ番の間隔", minval=10, step=10, group=group_round)
round_count = input.int(6, "上下に表示する本数", minval=1, maxval=15, group=group_round)
round_color = input.color(color.new(#9e9e9e, 30), "キリ番の色", group=group_round)

line_width = input.int(1, "ライン太さ", minval=1, maxval=3)

group_sig = "【サイン】"
use_sig = input.bool(true, "サインを表示", group=group_sig)
use_wick = input.bool(true, "ヒゲ反転", group=group_sig)
use_dbl = input.bool(true, "ダブルトップ/ボトム", group=group_sig)
use_fail = input.bool(true, "抜け失敗", group=group_sig)
atr_len = input.int(14, "ATR期間", minval=1, group=group_sig)
tol_mult = input.float(0.15, "節目への接近許容（ATR倍）", minval=0.0, step=0.05, group=group_sig)
pierce_mult = input.float(0.30, "節目の突き抜け許容（ATR倍）", minval=0.0, step=0.05, group=group_sig)
wick_ratio = input.float(2.0, "ヒゲ/実体の比率", minval=0.5, step=0.5, group=group_sig)
wick_min = input.float(0.5, "ヒゲの最小長（ATR倍）", minval=0.0, step=0.1, group=group_sig)
pivot_len = input.int(3, "ピボット左右本数", minval=1, maxval=10, group=group_sig)
dbl_lookback = input.int(20, "ダブルの最大間隔（本）", minval=3, maxval=200, group=group_sig)
dbl_depth = input.float(0.5, "ダブルの谷の深さ（ATR倍）", minval=0.0, step=0.1, group=group_sig)
fail_lookback = input.int(30, "抜け失敗の観測本数", minval=5, maxval=200, group=group_sig)
fail_touches = input.int(2, "抜け失敗の最小タッチ回数", minval=2, maxval=10, group=group_sig)
fail_away = input.float(1.0, "離脱判定（ATR倍）", minval=0.1, step=0.1, group=group_sig)
cooldown = input.int(10, "同じ節目のクールダウン（本）", minval=0, maxval=200, group=group_sig)

//══════════════════════════════════════════════════════════════
// 前日・前週データ
//══════════════════════════════════════════════════════════════
[pdh, pdl, pdc, pdo] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1], open[1]], lookahead=barmerge.lookahead_on)
[pwh, pwl, pwc] = request.security(syminfo.tickerid, "W", [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)

// 今週始値: チャート自身の足から「今週最初の足の始値」を取得（週足リクエストと足の区切りがズレる銘柄への対策）
wk_no = weekofyear(time, "Asia/Tokyo")
wk_chg = ta.change(wk_no)
var float cwo = na
if barstate.isfirst or wk_chg != 0
    cwo := open

// ピボット
pp = (pdh + pdl + pdc) / 3.0
r1 = 2.0 * pp - pdl
s1 = 2.0 * pp - pdh
r2 = pp + (pdh - pdl)
s2 = pp - (pdh - pdl)

//══════════════════════════════════════════════════════════════
// セッション高安（タイムゾーンをAsia/Tokyoに固定）
//══════════════════════════════════════════════════════════════
var box tokyoBox  = na
var box londonBox = na
var box nyBox     = na

var float tokyoH_cur = na
var float tokyoL_cur = na
var float londonH_cur = na
var float londonL_cur = na
var float nyH_cur = na
var float nyL_cur = na

var float tokyoH = na
var float tokyoL = na
var float londonH = na
var float londonL = na
var float nyH = na
var float nyL = na

// タイムゾーンを明示的にAsia/Tokyoに指定
is_tokyo  = not na(time(timeframe.period, tokyo_sess, "Asia/Tokyo"))
is_london = not na(time(timeframe.period, london_sess, "Asia/Tokyo"))
is_ny     = not na(time(timeframe.period, ny_sess, "Asia/Tokyo"))

// ===== 東京 =====
if is_tokyo and not is_tokyo[1]
    tokyoH_cur := high
    tokyoL_cur := low
    if show_tokyo_box
        if not na(tokyoBox)
            box.delete(tokyoBox)
        tokyoBox := box.new(bar_index, high, bar_index, low, bgcolor=tokyo_bg, border_color=color.new(tokyo_bg, 40), border_width=1)
else if is_tokyo
    tokyoH_cur := math.max(nz(tokyoH_cur), high)
    tokyoL_cur := math.min(nz(tokyoL_cur), low)
    if not na(tokyoBox)
        box.set_top(tokyoBox, tokyoH_cur)
        box.set_bottom(tokyoBox, tokyoL_cur)
        box.set_right(tokyoBox, bar_index)
else if is_tokyo[1] and not is_tokyo
    tokyoH := tokyoH_cur
    tokyoL := tokyoL_cur

// ===== ロンドン =====
if is_london and not is_london[1]
    londonH_cur := high
    londonL_cur := low
    if show_london_box
        if not na(londonBox)
            box.delete(londonBox)
        londonBox := box.new(bar_index, high, bar_index, low, bgcolor=london_bg, border_color=color.new(london_bg, 40), border_width=1)
else if is_london
    londonH_cur := math.max(nz(londonH_cur), high)
    londonL_cur := math.min(nz(londonL_cur), low)
    if not na(londonBox)
        box.set_top(londonBox, londonH_cur)
        box.set_bottom(londonBox, londonL_cur)
        box.set_right(londonBox, bar_index)
else if is_london[1] and not is_london
    londonH := londonH_cur
    londonL := londonL_cur

// ===== NY =====
if is_ny and not is_ny[1]
    nyH_cur := high
    nyL_cur := low
    if show_ny_box
        if not na(nyBox)
            box.delete(nyBox)
        nyBox := box.new(bar_index, high, bar_index, low, bgcolor=ny_bg, border_color=color.new(ny_bg, 40), border_width=1)
else if is_ny
    nyH_cur := math.max(nz(nyH_cur), high)
    nyL_cur := math.min(nz(nyL_cur), low)
    if not na(nyBox)
        box.set_top(nyBox, nyH_cur)
        box.set_bottom(nyBox, nyL_cur)
        box.set_right(nyBox, bar_index)
else if is_ny[1] and not is_ny
    nyH := nyH_cur
    nyL := nyL_cur

//══════════════════════════════════════════════════════════════
// サイン判定（各バー時点の節目を配列にして判定）
//══════════════════════════════════════════════════════════════
atr = ta.atr(atr_len)
tol = atr * tol_mult
pierce = atr * pierce_mult
away = atr * fail_away

f_push(arr, cond, v) =>
    if cond and not na(v)
        array.push(arr, v)

f_touch_sell(hi, cl, lv, t, p) =>
    hi >= lv - t and hi <= lv + p and cl < lv

f_touch_buy(lo, cl, lv, t, p) =>
    lo <= lv + t and lo >= lv - p and cl > lv

// 節目リスト（表示ONのものだけ）
levels = array.new_float()
f_push(levels, show_pdh, pdh)
f_push(levels, show_pdl, pdl)
f_push(levels, show_pdc, pdc)
f_push(levels, show_pdo, pdo)
f_push(levels, show_pwh, pwh)
f_push(levels, show_pwl, pwl)
f_push(levels, show_cwo, cwo)
f_push(levels, show_pivot and show_r2, r2)
f_push(levels, show_pivot and show_r1, r1)
f_push(levels, show_pivot and show_pp, pp)
f_push(levels, show_pivot and show_s1, s1)
f_push(levels, show_pivot and show_s2, s2)
f_push(levels, show_tokyo_box, tokyoH)
f_push(levels, show_tokyo_box, tokyoL)
f_push(levels, show_london_box, londonH)
f_push(levels, show_london_box, londonL)
f_push(levels, show_ny_box, nyH)
f_push(levels, show_ny_box, nyL)
if show_round
    float rb = math.round(close / round_step) * round_step
    for i = -2 to 2
        float rlv = rb + i * round_step
        if rlv > 0
            array.push(levels, rlv)

n_lv = array.size(levels)

// ===== ① ヒゲ反転 =====
body = math.abs(close - open)
upper_wick = high - math.max(open, close)
lower_wick = math.min(open, close) - low

float sell_wick_lv = na
float buy_wick_lv = na
if use_wick and n_lv > 0
    for i = 0 to n_lv - 1
        float lv = array.get(levels, i)
        if f_touch_sell(high, close, lv, tol, pierce) and upper_wick >= body * wick_ratio and upper_wick >= atr * wick_min
            if na(sell_wick_lv) or math.abs(high - lv) < math.abs(high - sell_wick_lv)
                sell_wick_lv := lv
        if f_touch_buy(low, close, lv, tol, pierce) and lower_wick >= body * wick_ratio and lower_wick >= atr * wick_min
            if na(buy_wick_lv) or math.abs(low - lv) < math.abs(low - buy_wick_lv)
                buy_wick_lv := lv

// ===== ② ダブルトップ / ダブルボトム =====
ph = ta.pivothigh(high, pivot_len, pivot_len)
pl = ta.pivotlow(low, pivot_len, pivot_len)
var float prev_ph = na
var int prev_ph_bar = na
var float prev_pl = na
var int prev_pl_bar = na

float sell_dbl_lv = na
float buy_dbl_lv = na

if not na(ph)
    int cur_bar = bar_index - pivot_len
    if use_dbl and n_lv > 0 and not na(prev_ph) and cur_bar - prev_ph_bar <= dbl_lookback
        int span = bar_index - prev_ph_bar
        float valley = low
        for k = pivot_len to span
            valley := math.min(valley, low[k])
        if math.min(ph, prev_ph) - valley >= atr * dbl_depth
            for i = 0 to n_lv - 1
                float lv = array.get(levels, i)
                if ph >= lv - tol and ph <= lv + pierce and prev_ph >= lv - tol and prev_ph <= lv + pierce and close < lv
                    if na(sell_dbl_lv) or math.abs(ph - lv) < math.abs(ph - sell_dbl_lv)
                        sell_dbl_lv := lv
    prev_ph := ph
    prev_ph_bar := cur_bar

if not na(pl)
    int cur_bar = bar_index - pivot_len
    if use_dbl and n_lv > 0 and not na(prev_pl) and cur_bar - prev_pl_bar <= dbl_lookback
        int span = bar_index - prev_pl_bar
        float peak = high
        for k = pivot_len to span
            peak := math.max(peak, high[k])
        if peak - math.max(pl, prev_pl) >= atr * dbl_depth
            for i = 0 to n_lv - 1
                float lv = array.get(levels, i)
                if pl <= lv + tol and pl >= lv - pierce and prev_pl <= lv + tol and prev_pl >= lv - pierce and close > lv
                    if na(buy_dbl_lv) or math.abs(pl - lv) < math.abs(pl - buy_dbl_lv)
                        buy_dbl_lv := lv
    prev_pl := pl
    prev_pl_bar := cur_bar

// ===== ③ 抜け失敗（何度も跳ね返され、節目から離れ始めた） =====
float sell_fail_lv = na
float buy_fail_lv = na
if use_fail and n_lv > 0 and not na(away)
    for i = 0 to n_lv - 1
        float lv = array.get(levels, i)
        if close < lv and lv - close >= away and lv - close[1] < away
            int touches = 0
            bool broke = false
            for k = 1 to fail_lookback
                if close[k] >= lv
                    broke := true
                if f_touch_sell(high[k], close[k], lv, tol, pierce) and not f_touch_sell(high[k + 1], close[k + 1], lv, tol, pierce)
                    touches += 1
            if touches >= fail_touches and not broke
                if na(sell_fail_lv) or (lv - close) < (sell_fail_lv - close)
                    sell_fail_lv := lv
        if close > lv and close - lv >= away and close[1] - lv < away
            int touches = 0
            bool broke = false
            for k = 1 to fail_lookback
                if close[k] <= lv
                    broke := true
                if f_touch_buy(low[k], close[k], lv, tol, pierce) and not f_touch_buy(low[k + 1], close[k + 1], lv, tol, pierce)
                    touches += 1
            if touches >= fail_touches and not broke
                if na(buy_fail_lv) or (close - lv) < (close - buy_fail_lv)
                    buy_fail_lv := lv

// ===== 統合・クールダウン =====
var float last_sell_lv = na
var int last_sell_bar = na
var float last_buy_lv = na
var int last_buy_bar = na

float sell_lv = not na(sell_dbl_lv) ? sell_dbl_lv : not na(sell_fail_lv) ? sell_fail_lv : sell_wick_lv
float buy_lv = not na(buy_dbl_lv) ? buy_dbl_lv : not na(buy_fail_lv) ? buy_fail_lv : buy_wick_lv

bool sell_ok = use_sig and not na(sell_lv) and barstate.isconfirmed
if sell_ok and not na(last_sell_lv) and math.abs(sell_lv - last_sell_lv) <= tol and bar_index - last_sell_bar < cooldown
    sell_ok := false
if sell_ok
    last_sell_lv := sell_lv
    last_sell_bar := bar_index

bool buy_ok = use_sig and not na(buy_lv) and barstate.isconfirmed
if buy_ok and not na(last_buy_lv) and math.abs(buy_lv - last_buy_lv) <= tol and bar_index - last_buy_bar < cooldown
    buy_ok := false
if buy_ok
    last_buy_lv := buy_lv
    last_buy_bar := bar_index

sig_sell_dbl = sell_ok and not na(sell_dbl_lv)
sig_sell_fail = sell_ok and not sig_sell_dbl and not na(sell_fail_lv)
sig_sell_wick = sell_ok and not sig_sell_dbl and not sig_sell_fail
sig_buy_dbl = buy_ok and not na(buy_dbl_lv)
sig_buy_fail = buy_ok and not sig_buy_dbl and not na(buy_fail_lv)
sig_buy_wick = buy_ok and not sig_buy_dbl and not sig_buy_fail

plotshape(sig_sell_wick, "売り:ヒゲ", style=shape.arrowdown, location=location.abovebar, color=#ff1744, size=size.small, text="ヒゲ", textcolor=#ff1744)
plotshape(sig_sell_dbl, "売り:ダブルトップ", style=shape.arrowdown, location=location.abovebar, color=#ff1744, size=size.small, text="DT", textcolor=#ff1744)
plotshape(sig_sell_fail, "売り:抜け失敗", style=shape.arrowdown, location=location.abovebar, color=#ff1744, size=size.small, text="失敗", textcolor=#ff1744)
plotshape(sig_buy_wick, "買い:ヒゲ", style=shape.arrowup, location=location.belowbar, color=#00e676, size=size.small, text="ヒゲ", textcolor=#00e676)
plotshape(sig_buy_dbl, "買い:ダブルボトム", style=shape.arrowup, location=location.belowbar, color=#00e676, size=size.small, text="DB", textcolor=#00e676)
plotshape(sig_buy_fail, "買い:抜け失敗", style=shape.arrowup, location=location.belowbar, color=#00e676, size=size.small, text="失敗", textcolor=#00e676)

alertcondition(sig_sell_wick or sig_sell_dbl or sig_sell_fail, "売りサイン", "節目: 売りサイン")
alertcondition(sig_buy_wick or sig_buy_dbl or sig_buy_fail, "買いサイン", "節目: 買いサイン")

//══════════════════════════════════════════════════════════════
// ライン＆ラベル
//══════════════════════════════════════════════════════════════
var line l_pdh = na
var line l_pdl = na
var line l_pdc = na
var line l_pdo = na
var line l_pwh = na
var line l_pwl = na
var line l_cwo = na
var line l_r2  = na
var line l_r1  = na
var line l_pp  = na
var line l_s1  = na
var line l_s2  = na
var line l_tokyoH  = na
var line l_tokyoL  = na
var line l_londonH = na
var line l_londonL = na
var line l_nyH     = na
var line l_nyL     = na

var label lb_pdh = na
var label lb_pdl = na
var label lb_pdc = na
var label lb_pdo = na
var label lb_pwh = na
var label lb_pwl = na
var label lb_cwo = na
var label lb_r2  = na
var label lb_r1  = na
var label lb_pp  = na
var label lb_s1  = na
var label lb_s2  = na
var label lb_tokyoH  = na
var label lb_tokyoL  = na
var label lb_londonH = na
var label lb_londonL = na
var label lb_nyH     = na
var label lb_nyL     = na

var line[] round_lines = array.new_line()
var label[] round_labels = array.new_label()

if barstate.islast
    // ===== 古いものを削除 =====
    if not na(l_pdh)
        line.delete(l_pdh)
    if not na(l_pdl)
        line.delete(l_pdl)
    if not na(l_pdc)
        line.delete(l_pdc)
    if not na(l_pdo)
        line.delete(l_pdo)
    if not na(l_pwh)
        line.delete(l_pwh)
    if not na(l_pwl)
        line.delete(l_pwl)
    if not na(l_cwo)
        line.delete(l_cwo)
    if not na(l_r2)
        line.delete(l_r2)
    if not na(l_r1)
        line.delete(l_r1)
    if not na(l_pp)
        line.delete(l_pp)
    if not na(l_s1)
        line.delete(l_s1)
    if not na(l_s2)
        line.delete(l_s2)
    if not na(l_tokyoH)
        line.delete(l_tokyoH)
    if not na(l_tokyoL)
        line.delete(l_tokyoL)
    if not na(l_londonH)
        line.delete(l_londonH)
    if not na(l_londonL)
        line.delete(l_londonL)
    if not na(l_nyH)
        line.delete(l_nyH)
    if not na(l_nyL)
        line.delete(l_nyL)

    if not na(lb_pdh)
        label.delete(lb_pdh)
    if not na(lb_pdl)
        label.delete(lb_pdl)
    if not na(lb_pdc)
        label.delete(lb_pdc)
    if not na(lb_pdo)
        label.delete(lb_pdo)
    if not na(lb_pwh)
        label.delete(lb_pwh)
    if not na(lb_pwl)
        label.delete(lb_pwl)
    if not na(lb_cwo)
        label.delete(lb_cwo)
    if not na(lb_r2)
        label.delete(lb_r2)
    if not na(lb_r1)
        label.delete(lb_r1)
    if not na(lb_pp)
        label.delete(lb_pp)
    if not na(lb_s1)
        label.delete(lb_s1)
    if not na(lb_s2)
        label.delete(lb_s2)
    if not na(lb_tokyoH)
        label.delete(lb_tokyoH)
    if not na(lb_tokyoL)
        label.delete(lb_tokyoL)
    if not na(lb_londonH)
        label.delete(lb_londonH)
    if not na(lb_londonL)
        label.delete(lb_londonL)
    if not na(lb_nyH)
        label.delete(lb_nyH)
    if not na(lb_nyL)
        label.delete(lb_nyL)

    if array.size(round_lines) > 0
        for i = 0 to array.size(round_lines) - 1
            line.delete(array.get(round_lines, i))
            label.delete(array.get(round_labels, i))
        array.clear(round_lines)
        array.clear(round_labels)

    // ===== 新しく描画 =====
    if show_pdh and not na(pdh)
        l_pdh  := line.new(bar_index, pdh, bar_index + 1, pdh, color=#ff5252, width=line_width, extend=extend.right)
        lb_pdh := label.new(bar_index + 2, pdh, "前日高値  " + str.tostring(pdh, format.mintick), style=label.style_label_left, color=color.new(#ff5252, 15), textcolor=color.white, size=size.normal)

    if show_pdl and not na(pdl)
        l_pdl  := line.new(bar_index, pdl, bar_index + 1, pdl, color=#4caf50, width=line_width, extend=extend.right)
        lb_pdl := label.new(bar_index + 2, pdl, "前日安値  " + str.tostring(pdl, format.mintick), style=label.style_label_left, color=color.new(#4caf50, 15), textcolor=color.white, size=size.normal)

    if show_pdc and not na(pdc)
        l_pdc  := line.new(bar_index, pdc, bar_index + 1, pdc, color=#ffeb3b, width=line_width, extend=extend.right)
        lb_pdc := label.new(bar_index + 2, pdc, "前日終値  " + str.tostring(pdc, format.mintick), style=label.style_label_left, color=color.new(#ffeb3b, 15), textcolor=color.black, size=size.normal)

    if show_pdo and not na(pdo)
        l_pdo  := line.new(bar_index, pdo, bar_index + 1, pdo, color=#90caf9, width=line_width, extend=extend.right)
        lb_pdo := label.new(bar_index + 2, pdo, "前日始値  " + str.tostring(pdo, format.mintick), style=label.style_label_left, color=color.new(#90caf9, 15), textcolor=color.white, size=size.normal)

    if show_pwh and not na(pwh)
        l_pwh  := line.new(bar_index, pwh, bar_index + 1, pwh, color=#ff9800, width=line_width, extend=extend.right)
        lb_pwh := label.new(bar_index + 2, pwh, "前週高値  " + str.tostring(pwh, format.mintick), style=label.style_label_left, color=color.new(#ff9800, 15), textcolor=color.white, size=size.normal)

    if show_pwl and not na(pwl)
        l_pwl  := line.new(bar_index, pwl, bar_index + 1, pwl, color=#ff9800, width=line_width, extend=extend.right)
        lb_pwl := label.new(bar_index + 2, pwl, "前週安値  " + str.tostring(pwl, format.mintick), style=label.style_label_left, color=color.new(#ff9800, 15), textcolor=color.white, size=size.normal)

    if show_cwo and not na(cwo)
        l_cwo  := line.new(bar_index, cwo, bar_index + 1, cwo, color=#ffeb3b, width=line_width, extend=extend.right)
        lb_cwo := label.new(bar_index + 2, cwo, "今週始値  " + str.tostring(cwo, format.mintick), style=label.style_label_left, color=color.new(#ffeb3b, 15), textcolor=color.black, size=size.normal)

    if show_pivot
        if show_r2 and not na(r2)
            l_r2  := line.new(bar_index, r2, bar_index + 1, r2, color=#f44336, width=line_width, extend=extend.right)
            lb_r2 := label.new(bar_index + 2, r2, "ピボットR2  " + str.tostring(r2, format.mintick), style=label.style_label_left, color=color.new(#f44336, 15), textcolor=color.white, size=size.normal)
        if show_r1 and not na(r1)
            l_r1  := line.new(bar_index, r1, bar_index + 1, r1, color=#ef5350, width=line_width, extend=extend.right)
            lb_r1 := label.new(bar_index + 2, r1, "ピボットR1  " + str.tostring(r1, format.mintick), style=label.style_label_left, color=color.new(#ef5350, 15), textcolor=color.white, size=size.normal)
        if show_pp and not na(pp)
            l_pp  := line.new(bar_index, pp, bar_index + 1, pp, color=#ffffff, width=line_width, extend=extend.right)
            lb_pp := label.new(bar_index + 2, pp, "ピボットPP  " + str.tostring(pp, format.mintick), style=label.style_label_left, color=color.new(#ffffff, 15), textcolor=color.black, size=size.normal)
        if show_s1 and not na(s1)
            l_s1  := line.new(bar_index, s1, bar_index + 1, s1, color=#66bb6a, width=line_width, extend=extend.right)
            lb_s1 := label.new(bar_index + 2, s1, "ピボットS1  " + str.tostring(s1, format.mintick), style=label.style_label_left, color=color.new(#66bb6a, 15), textcolor=color.white, size=size.normal)
        if show_s2 and not na(s2)
            l_s2  := line.new(bar_index, s2, bar_index + 1, s2, color=#43a047, width=line_width, extend=extend.right)
            lb_s2 := label.new(bar_index + 2, s2, "ピボットS2  " + str.tostring(s2, format.mintick), style=label.style_label_left, color=color.new(#43a047, 15), textcolor=color.white, size=size.normal)

    // 東京
    if show_tokyo_box
        if not na(tokyoH)
            l_tokyoH  := line.new(bar_index, tokyoH, bar_index + 1, tokyoH, color=#00bcd4, width=line_width, extend=extend.right)
            lb_tokyoH := label.new(bar_index + 2, tokyoH, "東京高値  " + str.tostring(tokyoH, format.mintick), style=label.style_label_left, color=color.new(#00bcd4, 15), textcolor=color.white, size=size.normal)
        if not na(tokyoL)
            l_tokyoL  := line.new(bar_index, tokyoL, bar_index + 1, tokyoL, color=#00bcd4, width=line_width, extend=extend.right)
            lb_tokyoL := label.new(bar_index + 2, tokyoL, "東京安値  " + str.tostring(tokyoL, format.mintick), style=label.style_label_left, color=color.new(#00bcd4, 15), textcolor=color.white, size=size.normal)

    // ロンドン
    if show_london_box
        if not na(londonH)
            l_londonH  := line.new(bar_index, londonH, bar_index + 1, londonH, color=#ff9800, width=line_width, extend=extend.right)
            lb_londonH := label.new(bar_index + 2, londonH, "ロンドン高値  " + str.tostring(londonH, format.mintick), style=label.style_label_left, color=color.new(#ff9800, 15), textcolor=color.white, size=size.normal)
        if not na(londonL)
            l_londonL  := line.new(bar_index, londonL, bar_index + 1, londonL, color=#ff9800, width=line_width, extend=extend.right)
            lb_londonL := label.new(bar_index + 2, londonL, "ロンドン安値  " + str.tostring(londonL, format.mintick), style=label.style_label_left, color=color.new(#ff9800, 15), textcolor=color.white, size=size.normal)

    // NY
    if show_ny_box
        if not na(nyH)
            l_nyH  := line.new(bar_index, nyH, bar_index + 1, nyH, color=#7e57c2, width=line_width, extend=extend.right)
            lb_nyH := label.new(bar_index + 2, nyH, "NY高値  " + str.tostring(nyH, format.mintick), style=label.style_label_left, color=color.new(#7e57c2, 15), textcolor=color.white, size=size.normal)
        if not na(nyL)
            l_nyL  := line.new(bar_index, nyL, bar_index + 1, nyL, color=#7e57c2, width=line_width, extend=extend.right)
            lb_nyL := label.new(bar_index + 2, nyL, "NY安値  " + str.tostring(nyL, format.mintick), style=label.style_label_left, color=color.new(#7e57c2, 15), textcolor=color.white, size=size.normal)

    // キリ番
    if show_round
        float base = math.round(close / round_step) * round_step
        for i = -round_count to round_count
            float level = base + i * round_step
            if level > 0
                line ln = line.new(bar_index, level, bar_index + 1, level, color=round_color, width=1, extend=extend.right, style=line.style_dotted)
                label lb = label.new(bar_index + 2, level, str.tostring(level, "#"), style=label.style_label_left, color=color.new(round_color, 70), textcolor=color.gray, size=size.small)
                array.push(round_lines, ln)
                array.push(round_labels, lb)